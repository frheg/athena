# The gate: the one door into Athena. Basic sign-in here; behind it, / is the UI and /api is core.
# core trusts requests that carry API_TOKEN, which only the gate adds.
server {
    listen 8080;
    server_name _;
    server_tokens off;
    client_max_body_size 2m;

    auth_basic "Athena";
    auth_basic_user_file /etc/nginx/conf.d/htpasswd;

    location /api/ {
        proxy_pass http://core:8080;
        proxy_http_version 1.1;
        proxy_set_header Authorization "Bearer ${API_TOKEN}";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # turn events are a long Server-Sent Events stream
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }
    location / {
        proxy_pass http://ui:8080;
        proxy_set_header Host $host;
    }
    location = /health {
        auth_basic off;
        access_log off;
        return 200 "ok\n";
    }
}
