# Copy to .env and fill in. Make tokens with: openssl rand -hex 24
# Nothing here is used by Athena except through docker-compose.yml.

# --- sign-in at the gate (http://localhost:8080) ---
GATE_USER=me
GATE_PASSWORD=change-me
GATE_PORT=127.0.0.1:8080

# --- tokens between the parts ---
API_TOKEN=change-me-api
TOKEN_WEB=change-me-web
TOKEN_SOURCES=change-me-sources
TOKEN_EVERYDAY=change-me-everyday
TOKEN_MEMORY=change-me-memory
TOKEN_NOTES=change-me-notes
TOKEN_NOTIFY=change-me-notify
TOKEN_FILES=change-me-files

# --- data services (the "deps" profile runs them; or point these at your own) ---
POSTGRES_PASSWORD=change-me-db
DATABASE_URL=postgres://athena:change-me-db@postgres:5432/athena?sslmode=disable
MEMORY_DATABASE_URL=postgres://athena:change-me-db@postgres:5432/memory?sslmode=disable
NOTES_DATABASE_URL=postgres://athena:change-me-db@postgres:5432/notes?sslmode=disable
FILES_DATABASE_URL=postgres://athena:change-me-db@postgres:5432/files?sslmode=disable
QDRANT_URL=http://qdrant:6333
QDRANT_KEY=
SEARXNG_URL=http://searxng:8080
SEARXNG_SECRET=change-me-searxng

# --- models: any OpenAI-compatible server. The "model" profile runs llama.cpp with files from ./models ---
LLM_URL=http://model:8080/v1
LLM_MODEL=
LLM_KEY=
LLM_FALLBACK_URL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_KEY=
MODEL_FILE=model.gguf
MODEL_CONTEXT=16384
EMBED_URL=http://embed:8080/v1
EMBED_MODEL=
EMBED_FILE=embed.gguf
# models that can see images (comma-separated, * = all); for llama.cpp, start them with --mmproj
VISION_MODELS=

# --- you ---
TIME_ZONE=Europe/Oslo
ASSISTANT_NAME=Athena

# --- mail out (empty SMTP_HOST = dry run: messages are only logged) ---
RECIPIENTS=owner=you@example.org
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- optional tool keys ---
GITHUB_TOKEN=
ENTUR_CLIENT_NAME=
BRING_API_UID=
BRING_API_KEY=
